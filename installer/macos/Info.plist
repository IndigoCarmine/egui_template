<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Bundle metadata for the macOS .app. __VERSION__ is substituted by
  .github/workflows/release.yml from the git tag.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>egui Template</string>
    <key>CFBundleDisplayName</key>
    <string>egui Template</string>
    <key>CFBundleIdentifier</key>
    <string>com.example.egui-template</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleExecutable</key>
    <string>egui_template</string>
    <key>CFBundleIconFile</key>
    <string>icon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>10.15</string>
    <!-- Without this the app launches without a Dock icon or menu bar. -->
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
